# Copy this file to .env and fill in your own values.

# Must match the CLEAR_TOKEN set in backend/.env — used by the Settings page
# to authorize clearing alerts.
REACT_APP_CLEAR_TOKEN=

# Backend API base URL. Defaults to localhost:5000 if you leave this unset
# and don't reference process.env in App.js's API constant.
# REACT_APP_API_URL=http://localhost:5000/api
